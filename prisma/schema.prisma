// House Passport — kerne-domænemodel (Lag 1)
// Bolig er den varige rod; ejerskab er en tidsrelation; al deling via AccessGrant.
// RLS-policies og partielt unikt indeks ligger i prisma/sql/security.sql
// (Prisma udtrykker ikke RLS/partielle indekser i schemaet).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Professionel organisation = klassisk tenant (mægler/bank/forsikring/håndværker).
model Organization {
  id          String           @id @default(uuid()) @db.Uuid
  type        String // 'maegler' | 'bank' | 'forsikring' | 'haandvaerker' | 'administrator'
  name        String
  branding    Json             @default("{}")
  isIsolated  Boolean          @default(false) @map("is_isolated")
  createdAt   DateTime         @default(now()) @map("created_at")
  members     OrgMembership[]
  @@map("organization")
}

/// En fysisk person (kan være boligejer og/eller medlem af organisationer).
model Person {
  id              String            @id @default(uuid()) @db.Uuid
  displayName     String?           @map("display_name")
  email           String?           @unique
  passwordHash    String?           @map("password_hash")
  isAdmin         Boolean           @default(false) @map("is_admin")
  isMitidVerified Boolean           @default(false) @map("is_mitid_verified")
  createdAt       DateTime          @default(now()) @map("created_at")
  memberships     OrgMembership[]
  ownerships      OwnershipPeriod[]
  grantsGiven     AccessGrant[]     @relation("grantedBy")
  @@map("person")
}

/// Kobler person til organisation med en RBAC-rolle.
model OrgMembership {
  id        String       @id @default(uuid()) @db.Uuid
  orgId     String       @map("org_id") @db.Uuid
  personId  String       @map("person_id") @db.Uuid
  role      String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  person    Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  @@unique([orgId, personId])
  @@map("org_membership")
}

/// Bolig — den varige rod. IKKE tenant-ejet. Adgang styres via ejerskab + grants.
model Property {
  id           String            @id @default(uuid()) @db.Uuid
  bfeNumber    String            @unique @map("bfe_number")
  address      String
  bbrSnapshot  Json?             @map("bbr_snapshot")
  energyLabel  String?           @map("energy_label")
  propertyType String?           @map("property_type")
  buildYear    Int?              @map("build_year")
  createdAt    DateTime          @default(now()) @map("created_at")
  ownerships   OwnershipPeriod[]
  grants       AccessGrant[]
  documents    Document[]
  tasks        MaintenanceTask[]
  warranties   Warranty[]
  @@map("property")
}

/// Tidsbegrænset ejerskabsrelation. Højst én aktiv (valid_to IS NULL) pr. bolig
/// — håndhævet af et partielt unikt indeks i security.sql.
model OwnershipPeriod {
  id            String   @id @default(uuid()) @db.Uuid
  propertyId    String   @map("property_id") @db.Uuid
  personId      String   @map("person_id") @db.Uuid
  validFrom     DateTime @map("valid_from") @db.Date
  validTo       DateTime? @map("valid_to") @db.Date
  mitidVerified Boolean  @default(false) @map("mitid_verified")
  property      Property @relation(fields: [propertyId], references: [id])
  person        Person   @relation(fields: [personId], references: [id])
  @@index([propertyId])
  @@map("ownership_period")
}

/// Hjertet i al deling: scoped, tidsbegrænset, samtykkebaseret adgang til en bolig.
model AccessGrant {
  id          String    @id @default(uuid()) @db.Uuid
  propertyId  String    @map("property_id") @db.Uuid
  subjectType String    @map("subject_type") // 'person' | 'organization'
  subjectId   String    @map("subject_id") @db.Uuid
  scope       String[] // fx {documents:read, maintenance:read}
  permission  String // 'read' | 'write' | 'admin'
  validFrom   DateTime  @default(now()) @map("valid_from")
  validTo     DateTime? @map("valid_to")
  grantedBy   String    @map("granted_by") @db.Uuid
  consentId   String?   @map("consent_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  property    Property  @relation(fields: [propertyId], references: [id])
  grantor     Person    @relation("grantedBy", fields: [grantedBy], references: [id])
  @@index([subjectType, subjectId, propertyId])
  @@index([propertyId])
  @@map("access_grant")
}

/// Dokument — tilhører altid en bolig (aldrig direkte en bruger).
/// (Hash-partitionering på property_id påføres i en senere produktionsmigration.)
model Document {
  id               String   @id @default(uuid()) @db.Uuid
  propertyId       String   @map("property_id") @db.Uuid
  filename         String?
  category         String?
  source           String? // 'manual' | 'email' | 'craftsman' | 'registry'
  isTransferable   Boolean  @default(true) @map("is_transferable")
  aiMetadata       Json?    @map("ai_metadata")
  s3Key            String   @map("s3_key")
  encryptionKeyRef String   @map("encryption_key_ref")
  processingStatus String   @default("pending") @map("processing_status")
  idempotencyKey   String?  @unique @map("idempotency_key")
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime @default(now()) @map("created_at")
  property         Property @relation(fields: [propertyId], references: [id])
  @@index([propertyId])
  @@map("document")
}

/// Vedligeholdelsesopgave — knyttet til boligen. Driver vedligeholdelsesscoren.
/// Kan være tilbagevendende (interval_months) — så genskabes næste forekomst,
/// når en opgave markeres fuldført.
model MaintenanceTask {
  id             String    @id @default(uuid()) @db.Uuid
  propertyId     String    @map("property_id") @db.Uuid
  title          String
  category       String?
  status         String    @default("open") // 'open' | 'done'
  priority       String    @default("normal") // 'low' | 'normal' | 'high'
  dueDate        DateTime? @map("due_date") @db.Date
  intervalMonths Int?      @map("interval_months")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  property       Property  @relation(fields: [propertyId], references: [id])
  @@index([propertyId])
  @@map("maintenance_task")
}

/// Garanti — knyttet til boligen (og evt. et dokument). Driver "aktive garantier".
model Warranty {
  id         String    @id @default(uuid()) @db.Uuid
  propertyId String    @map("property_id") @db.Uuid
  title      String
  provider   String?
  category   String?
  startDate  DateTime? @map("start_date") @db.Date
  endDate    DateTime? @map("end_date") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at")
  property   Property  @relation(fields: [propertyId], references: [id])
  @@index([propertyId])
  @@map("warranty")
}

model PropertyTransfer {
  id           String    @id @default(uuid()) @db.Uuid
  propertyId   String    @map("property_id") @db.Uuid
  fromPersonId String    @map("from_person_id") @db.Uuid
  toEmail      String    @map("to_email")
  toPersonId   String?   @map("to_person_id") @db.Uuid
  saleDate     DateTime  @map("sale_date") @db.Date
  status       String    @default("pending") // pending | accepted | cancelled | superseded
  createdAt    DateTime  @default(now()) @map("created_at")
  completedAt  DateTime? @map("completed_at")
  @@index([toPersonId])
  @@index([toEmail])
  @@index([propertyId])
  @@map("property_transfer")
}
